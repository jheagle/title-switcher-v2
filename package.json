{
  "name": "title-switcher",
  "version": "2.1.18",
  "description": "Add typing effect to titles and also switch through several titles.",
  "main": "dist/main.min.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "docs": "gulp docs",
    "publish:bundle": "gulp copyFiles",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "resolutions": "npx npm-force-resolutions",
    "test": "gulp testFull",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:quick": "gulp testQuick",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest",
    "lint": "gulp lint"
  },
  "keywords": [
    "decorative",
    "design",
    "creative",
    "title",
    "typing",
    "typing-effect"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/title-switcher-v2.git"
  },
  "author": "Joshua Heagle",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jheagle/title-switcher-v2/issues"
  },
  "homepage": "https://github.com/jheagle/title-switcher-v2#readme",
  "devDependencies": {
    "js-build-tools": "^6.4.1",
    "release-it": "^21.1.1",
    "typedoc": "^0.28.20"
  },
  "files": [
    "dist",
    "browser"
  ],
  "standard": {
    "env": [
      "jest"
    ]
  },
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
